{
  "schema_version": 1,
  "id": "black-myth-wukong",
  "name": "Black Myth: Wukong",
  "short_name": "Black Myth",
  "engine": "Unreal Engine 5",
  "maturity": "beta",
  "coordinate_system": {
    "position_unit": "centimeters",
    "meters_per_unit": 0.01,
    "scale_source": "user_provided",
    "native_position_preserved": true
  },
  "summary": "通过统一 UE Camera Runtime 读取精确位姿、执行原子绝对 setPose，并完成静态与平滑轨迹采集。",
  "documentation": "README.md",
  "examples": "examples",
  "capabilities": {
    "free_camera": "live_runtime_verified",
    "pose_read": "standalone_lwc_double_precision",
    "absolute_pose_control": "atomic_set_pose",
    "relative_pose_control": "standalone_native",
    "point_capture": "implemented",
    "still_capture": "implemented_obs_1080p_jpg",
    "depth_capture": "verified_native_d3d12_raw_depth_pixel_alignment_pending",
    "trajectory_capture": "implemented",
    "trajectory_replay": "standalone_in_process_hermite"
  },
  "actions": [
    {
      "id": "capture",
      "label": "打开统一采集界面（黑神话适配器）",
      "description": "启动统一游戏相机采集器，并载入黑神话 Camera Profile。",
      "platforms": ["windows"],
      "working_directory": ".",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{game}/launch_bmw_capture_studio.ps1"
      ]
    },
    {
      "id": "capture-linux",
      "label": "打开统一采集界面（Linux / 黑神话适配器）",
      "description": "启动统一游戏相机采集器，通过本机回环 Relay 连接 Proton 游戏。",
      "platforms": ["linux"],
      "working_directory": ".",
      "command": ["bash", "{game}/launch_bmw_capture_studio.sh"]
    }
  ]
}
