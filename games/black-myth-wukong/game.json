{
  "schema_version": 1,
  "id": "black-myth-wukong",
  "name": "Black Myth: Wukong",
  "short_name": "Black Myth",
  "engine": "Unreal Engine 5",
  "maturity": "experimental",
  "summary": "使用自研 Camera Bridge 读取精确位姿、执行原子绝对 setPose，并完成静态与平滑轨迹采集；不依赖 UUU。",
  "documentation": "README.md",
  "examples": "examples",
  "capabilities": {
    "free_camera": "standalone_bridge_pending_clean_runtime_acceptance",
    "pose_read": "standalone_lwc_double_precision",
    "absolute_pose_control": "atomic_set_pose",
    "relative_pose_control": "standalone_native",
    "point_capture": "implemented",
    "still_capture": "implemented_obs_1080p_jpg",
    "trajectory_capture": "implemented",
    "trajectory_replay": "standalone_in_process_hermite"
  },
  "actions": [
    {
      "id": "capture",
      "label": "打开黑神话采集界面",
      "description": "启动自研 Camera Bridge、点位和轨迹采集界面。",
      "platforms": ["windows"],
      "working_directory": ".",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{game}/launch_bmw_capture_studio.ps1"
      ]
    },
    {
      "id": "capture-linux",
      "label": "打开黑神话采集界面（Linux）",
      "description": "通过本机回环 Relay 连接 Proton 游戏中的自研 Camera Bridge。",
      "platforms": ["linux"],
      "working_directory": ".",
      "command": ["bash", "{game}/launch_bmw_capture_studio.sh"]
    }
  ]
}
