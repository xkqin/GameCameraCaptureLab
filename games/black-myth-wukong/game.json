{
  "schema_version": 1,
  "id": "black-myth-wukong",
  "name": "Black Myth: Wukong",
  "short_name": "Black Myth",
  "engine": "Unreal Engine 5",
  "maturity": "experimental",
  "summary": "通过 UUU Connector 读取位姿，并用 UUU 5.8.21 原生相对步进和 Pose 反馈闭环到绝对目标；非原子 setPose。",
  "documentation": "README.md",
  "examples": "examples",
  "capabilities": {
    "free_camera": "verified_with_uuu",
    "pose_read": "requires_connector_handshake",
    "absolute_pose_control": "feedback_closed_loop_target_pending_visual_acceptance",
    "relative_pose_control": "native_feedback",
    "point_capture": "implemented",
    "still_capture": "implemented",
    "trajectory_capture": "implemented",
    "trajectory_replay": "experimental_native_pose_feedback"
  },
  "actions": [
    {
      "id": "capture",
      "label": "打开黑神话采集界面",
      "description": "首次启动会创建游戏适配器自己的 .venv。",
      "platforms": ["windows"],
      "working_directory": ".",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{game}/launch_bmw_capture_studio.ps1"
      ]
    },
    {
      "id": "capture-linux",
      "label": "打开黑神话采集界面（Linux）",
      "description": "启动 Linux/Proton 采集界面；设置 BMW_BRIDGE_PORT 与 BMW_BRIDGE_ENDPOINT 后可通过回环 Bridge Relay 使用实时相机链路。",
      "platforms": ["linux"],
      "working_directory": ".",
      "command": [
        "bash",
        "{game}/launch_bmw_capture_studio.sh"
      ]
    }
  ]
}
