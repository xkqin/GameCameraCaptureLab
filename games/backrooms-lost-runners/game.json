      "platforms": ["windows"],
      "working_directory": ".",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{game}/launch_capture_studio.ps1"
      ]
