{
  "schema_version": 1,
  "id": "kcd2",
  "name": "Kingdom Come: Deliverance II",
  "short_name": "KCD2",
  "engine": "CryEngine",
  "camera_backend": "kcd2_igcs_camera_tools",
  "integration": "unified_launcher_route",
  "maturity": "beta",
  "coordinate_system": {
    "position_unit": "meters",
    "meters_per_unit": 1.0,
    "scale_source": "user_provided",
    "native_position_preserved": true
  },
  "summary": "读取 Camera Tools 位姿，管理边界点与扫描计划，并采集 OBS RGB 与 Pose；原始 D3D12 深度后端待接入。",
  "documentation": "README.md",
  "examples": "examples",
  "capabilities": {
    "free_camera": "verified_with_external_tool",
    "pose_read": "verified",
    "absolute_pose_control": "unverified_visual_result",
    "relative_pose_control": "verified",
    "point_capture": "verified",
    "still_capture": "implemented_requires_obs",
    "depth_capture": "backend_integration_pending",
    "trajectory_capture": "verified",
    "trajectory_replay": "relative_only"
  },
  "actions": [
    {
      "id": "capture",
      "label": "打开 KCD2 采集界面",
      "description": "打开 Pose、点位、静态照片、轨迹和分析标签页。",
      "platforms": ["windows"],
      "working_directory": ".",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "{repo}/launchers/launch_unified_capture_studio.ps1",
        "-GameId",
        "kcd2"
      ]
    }
  ]
}
