# Closed-source injectors, game mods, saves, and build products are never vendored.
*.dll
*.exe
*.addon64
*.pak
*.sav
*.pdb
*.obj
*.lib

!third_party/.gitkeep
!data/videos/.gitkeep
!data/frames/.gitkeep
!data/pose_logs/.gitkeep
!data/stills/.gitkeep
!outputs/.gitkeep
!runtime/.gitkeep

